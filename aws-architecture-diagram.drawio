    <!-- Legend ghi chú 3 nguồn dữ liệu -->
    <mxCell id="47" value="💡 3 nguồn dữ liệu Aurora có thể truy vấn trực tiếp (mục 1 bài viết):&#xa;① AWS Glue Data Catalog — tra cứu metadata, schema, partition&#xa;② Amazon S3 — đọc file Parquet, predicate pushdown + column pruning&#xa;③ Amazon S3 Tables — đọc bảng Iceberg format (ra mắt 2024), hỗ trợ snapshot" style="text;html=1;strokeColor=#147EBA;fillColor=#E6F2F8;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=0;spacingLeft=8;" vertex="1" parent="1">
